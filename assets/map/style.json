{
  "version": 8,
  "name": "Tunton offline light",
  "sources": {
    "basemap": {
      "type": "vector",
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#EEF0F3"
      }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "basemap",
      "source-layer": "earth",
      "paint": {
        "fill-color": "#F4F2EE"
      }
    },
    {
      "id": "landuse-green",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landuse",
      "filter": [
        "in",
        "kind",
        "park",
        "forest",
        "wood",
        "grass",
        "meadow",
        "scrub",
        "farmland",
        "orchard",
        "garden",
        "cemetery",
        "nature_reserve",
        "golf_course",
        "recreation_ground",
        "pitch",
        "playground"
      ],
      "paint": {
        "fill-color": "#DDEDD3"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "basemap",
      "source-layer": "water",
      "paint": {
        "fill-color": "#AFD3E6"
      }
    },
    {
      "id": "water-line",
      "type": "line",
      "source": "basemap",
      "source-layer": "water",
      "minzoom": 12,
      "filter": [
        "==",
        "$type",
        "LineString"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#AFD3E6",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          12,
          0.5,
          18,
          6
        ]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "basemap",
      "source-layer": "buildings",
      "minzoom": 13,
      "paint": {
        "fill-color": "#E4DFD7",
        "fill-outline-color": "#D6D0C6"
      }
    },
    {
      "id": "roads-path",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "filter": [
        "==",
        "kind",
        "path"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#D9D4CC",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          14,
          0.5,
          18,
          2.5
        ]
      },
      "minzoom": 14
    },
    {
      "id": "roads-minor-casing",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "filter": [
        "in",
        "kind",
        "minor_road",
        "other"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#D6D1C8",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          13,
          1.2,
          18,
          11
        ]
      },
      "minzoom": 13
    },
    {
      "id": "roads-major-casing",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "filter": [
        "==",
        "kind",
        "major_road"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#C9C2B6",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          10,
          1.4,
          18,
          15
        ]
      },
      "minzoom": 10
    },
    {
      "id": "roads-highway-casing",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "filter": [
        "==",
        "kind",
        "highway"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#D9A35B",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          8,
          1.4,
          18,
          18
        ]
      }
    },
    {
      "id": "roads-minor",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "filter": [
        "in",
        "kind",
        "minor_road",
        "other"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          11,
          0.4,
          18,
          9
        ]
      },
      "minzoom": 11
    },
    {
      "id": "roads-major",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "filter": [
        "==",
        "kind",
        "major_road"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          9,
          0.6,
          18,
          13
        ]
      }
    },
    {
      "id": "roads-highway",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "filter": [
        "==",
        "kind",
        "highway"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FCE2B1",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          8,
          0.8,
          18,
          16
        ]
      }
    }
  ]
}
