{
  "expo": {
    "name": "Tunton APP",
    "slug": "tunton-app",
    "scheme": "tunton",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/tunton-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.tunton.app",
      "adaptiveIcon": {
        "backgroundColor": "#14191e",
        "foregroundImage": "./assets/tunton-adaptive-foreground.png",
        "backgroundImage": "./assets/tunton-adaptive-background.png",
        "monochromeImage": "./assets/tunton-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-sqlite",
      "@maplibre/maplibre-react-native",
      "expo-asset",
      [
        "expo-camera",
        {
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/tunton-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "762947e8-5d44-478f-b2c0-d7d51f809799"
      }
    }
  }
}
