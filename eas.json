{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "commuter"
      }
    },
    "development-driver": {
      "extends": "development",
      "env": {
        "APP_VARIANT": "driver"
      }
    },
    "development-gateway": {
      "extends": "development",
      "env": {
        "APP_VARIANT": "gateway"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "commuter"
      }
    },
    "preview-driver": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "driver"
      }
    },
    "preview-gateway": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "gateway"
      }
    },
    "release-driver": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "driver"
      }
    },
    "release-gateway": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "gateway"
      }
    }
  }
}
