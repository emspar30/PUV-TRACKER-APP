# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (never commit secrets; .env.example holds names only)
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

.env
.env.*
!.env.example
# Avatar originals (about 80 MB); the app uses the 256 px copies in assets/avatars
/assets/profile avatars/

# DR6: the SMS worker bundle (npm run worker:build)
services/sms-worker/dist/
services/sms-worker/logs/
# Gradle caches created by editors or local builds inside the native modules
modules/*/android/.gradle/
modules/*/android/build/

# EAS only (when this file exists EAS reads it instead of .gitignore): local notes and design exports
# that are not part of the app never go to the build servers
/session-context.md
/HANDOFF.md
/docs/history/

# Files kept only on the team PC, not in git (2026-11-13): the manuscript and its working notes, the
# saved tracker page, marketing drafts and generated output. Not part of the app; never uploaded
/docs/Manuscript_Revised_*.docx
/docs/Manuscript_Revised_*.pdf
/docs/A Mobile-Based Real-time Public Utility*.pdf
/docs/MANUSCRIPT_BRIEF.md
/docs/PANEL_COMMENTS_PROMPT.md
/docs/Tunton Build Tracker.html
/docs/Tunton Build Tracker_files/
/assets/data/BRAND.txt
/assets/data/LAUNCH.txt
/assets/data/TREND.txt
/assets/data/VALUE.txt
/graphify-out/
__pycache__/
