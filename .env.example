# Copy to .env and fill in. Never commit .env.
# Both Supabase values are public client keys (safe to ship in the app).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set to true to show the dev broadcast screen (deferred; see plan Revision 1)
EXPO_PUBLIC_DEV_BROADCAST=false

# Two team test accounts, created in the Supabase dashboard (see docs/BACKEND_SETUP.md).
# Used only by the integration tests and the vehicle simulator on this PC. Never shipped in the app.
# The writer is on the telemetry allowlist; the outsider is not.
TEST_WRITER_EMAIL=
TEST_WRITER_PASSWORD=
TEST_OUTSIDER_EMAIL=
TEST_OUTSIDER_PASSWORD=
